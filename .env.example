# =============================================================================
# Ministry Planner - Environment Configuration Blueprint
# =============================================================================
#
# SECURITY GUIDELINES:
# 1. PUBLIC variables MUST be prefixed with NEXT_PUBLIC_. These values are bundled
#    into the client-side JavaScript and are visible to anyone in the browser.
# 2. PRIVATE variables MUST NEVER be prefixed with NEXT_PUBLIC_. These are only
#    accessible in server-side runtimes (API routes, server actions, SSR).
# 3. NEVER commit `.env.local` or any production secret keys to version control.
# =============================================================================

# --- Client-Side / Public Variables (Safe for Browser Bundle) -----------------
# Firebase Client SDK Configuration (BaaS project credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps JavaScript API (Client Map Rendering)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Server-Side Only / Private Variables (NEVER expose to Client) -----------
# Firebase Admin SDK Credentials (Optional / Server Actions & Admin Tasks)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server Session & Encryption Keys (Optional)
SESSION_SECRET=
